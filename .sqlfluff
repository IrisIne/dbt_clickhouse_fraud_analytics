[sqlfluff]
dialect = clickhouse
templater = dbt
max_line_length = 120
exclude_rules = layout.select_targets, layout.cte_newline, structure.column_order

[sqlfluff:templater:dbt]
project_dir = dbt
profiles_dir = dbt
profile = fraud_analytics
target = dev

[sqlfluff:indentation]
tab_space_size = 4
indented_joins = true
